[Unit]
Description=Sovereign-Link Voice Interface (Web UI op port 8766)
After=network.target sovereign-link.service

[Service]
Type=simple
User=wouter
WorkingDirectory=/home/wouter/Development/sovereign-link
EnvironmentFile=/home/wouter/Development/sovereign-link/.env
Environment=LD_LIBRARY_PATH=/usr/local/lib/ollama/cuda_v12
ExecStart=/home/wouter/Development/sovereign-link/venv/bin/uvicorn voice_interface:app --host 0.0.0.0 --port 8766
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
