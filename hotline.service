[Unit]
Description=Luna Hotline — Voice-to-Voice Bridge (Twilio ↔ Luna LLM)
After=network.target sovereign-link.service

[Service]
Type=simple
User=wouter
WorkingDirectory=/home/wouter/Development/sovereign-link
EnvironmentFile=/home/wouter/Development/sovereign-link/.env
ExecStart=/home/wouter/Development/sovereign-link/.venv/bin/uvicorn hotline:app --host 0.0.0.0 --port 8765
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
